# Copia este archivo a .env y completa los valores (no subas .env a Git).

DEBUG=False
SECRET_KEY=genera-una-clave-segura-unica
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Producción con HTTPS (SCRUM-13) — activar en despliegue público
DJANGO_USE_HTTPS=False
# Detrás de nginx/Render/GCP (TLS en el proxy): use AMBAS a True
# DJANGO_USE_HTTPS=True
# TRUST_X_FORWARDED_PROTO=True
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
# Health checks HTTP internos: SECURE_SSL_REDIRECT=False
# Rutas exentas de redirect (regex, separadas por coma): ^/health/?$
# SECURE_REDIRECT_EXEMPT=^/health/?$
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False

# Registro público desactivado por defecto (SCRUM-15)
# Exportaciones Excel/API requieren is_staff (SCRUM-14)
# Estado auditoría remota: temp/audit/<user>/<job_id>/ (SCRUM-21)
# Tope upload Excel gerencial en bytes (SCRUM-24, default 15 MB)
# SINDYBOT_MAX_EXCEL_UPLOAD_BYTES=15728640
ALLOW_PUBLIC_REGISTRATION=False

# Depuracion de sesiones (SCRUM-25): solo aplica con DEBUG=True; ignorado en produccion
# ENABLE_SESSION_DEBUG_MIDDLEWARE=True

# Rate limit login/admin (SCRUM-26): intentos fallidos por IP en ventana de segundos
# SINDYBOT_LOGIN_RATE_LIMIT=10
# SINDYBOT_LOGIN_RATE_WINDOW=300
# Produccion multi-worker: cache compartido (requiere pip install redis)
# REDIS_URL=redis://127.0.0.1:6379/1

# MySQL (producción / entorno completo)
DB_NAME=auto_sbot
DB_USER=adminsbot
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Docker MySQL (solo si usas docker-compose)
MYSQL_ROOT_PASSWORD=

# Demo local sin MySQL (opcional)
USE_SQLITE_DEMO=False

# Google Gemini — auditoría LLM (SCRUM-33)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face — diarización WhisperX (SCRUM-7)
HF_TOKEN=

# Opcional — base AWS/RDS (SCRUM-30: mismo core.settings, sin ____settings legacy)
# USE_AWS_DATABASE=True
# AWS_DB_HOST=
# AWS_DB_USER=
# AWS_DB_PASSWORD=
# AWS_DB_NAME=
# AWS_DB_PORT=3306
# Alternativa legacy: DJANGO_SETTINGS_MODULE=core.settings_aws

# ---
# SindyBot v1.5 — plantilla de entorno
# Harold Castro (hcastro)
