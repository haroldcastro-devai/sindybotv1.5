# Copia este archivo a .env y completa los valores (no subas .env a Git).

DEBUG=False
SECRET_KEY=genera-una-clave-segura-unica
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Registro público desactivado por defecto (SCRUM-15)
ALLOW_PUBLIC_REGISTRATION=False

# MySQL (producción / entorno completo)
DB_NAME=auto_sbot
DB_USER=adminsbot
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Docker MySQL (solo si usas docker-compose)
MYSQL_ROOT_PASSWORD=

# Demo local sin MySQL (opcional)
USE_SQLITE_DEMO=False

# Google Gemini — auditoría LLM (SCRUM-33)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face — diarización WhisperX (SCRUM-7)
HF_TOKEN=

# Opcional — base AWS (solo si defines estas variables)
# AWS_DB_HOST=
# AWS_DB_USER=
# AWS_DB_PASSWORD=
# AWS_DB_NAME=

